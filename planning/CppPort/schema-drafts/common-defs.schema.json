{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sa3d/cppport/schema/common-defs_v1",
  "title": "SA3D CppPort Common Slice Definitions v1",
  "type": "object",
  "$defs": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "operation_count": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostic_count": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "node_index": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  }
}
