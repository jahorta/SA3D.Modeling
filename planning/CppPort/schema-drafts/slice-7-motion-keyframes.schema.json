{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sa3d/cppport/schema/sa3d_slice_7_motion_keyframes_v1",
  "title": "Slice 7 Motion + Keyframes",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice", "slice_schema", "stage", "run_id", "fixture_id", "operation_count", "diagnostic_count", "inputs", "outputs"],
  "properties": {
    "slice": { "const": 7 },
    "slice_schema": { "const": "sa3d_slice_7_motion_keyframes_v1" },
    "stage": { "$ref": "common-defs.schema.json#/$defs/stage" },
    "run_id": { "$ref": "common-defs.schema.json#/$defs/run_id" },
    "fixture_id": { "$ref": "common-defs.schema.json#/$defs/fixture_id" },
    "operation_count": { "$ref": "common-defs.schema.json#/$defs/operation_count" },
    "diagnostic_count": { "$ref": "common-defs.schema.json#/$defs/diagnostic_count" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_header", "channels"],
      "properties": {
        "motion_header": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_count", "keyframe_type_mask", "interpolation_mode", "short_rot"],
          "properties": {
            "node_count": { "type": "integer", "minimum": 0 },
            "keyframe_type_mask": { "type": "integer", "minimum": 0 },
            "interpolation_mode": { "type": "string", "enum": ["linear", "spline", "user", "reserved"] },
            "short_rot": { "type": "boolean" }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_index", "channel", "count"],
            "properties": {
              "node_index": { "type": "integer", "minimum": 0 },
              "channel": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_count", "channel_hash"],
      "properties": {
        "frame_count": { "type": "integer", "minimum": 0 },
        "channel_hash": { "type": "string", "minLength": 8 }
      }
    },
    "diagnostics": { "$ref": "common-defs.schema.json#/$defs/diagnostics" }
  }
}
